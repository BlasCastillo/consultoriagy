APP_NAME="SGCJ - Yaracuy"
APP_ENV=local
APP_KEY=base64:ECWx+Gz8hEwnWN9ps/VYiVTM46pmy3tgVz0+UJNaFIo=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL 17) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sgc_db
DB_USERNAME=postgres
DB_PASSWORD=123456

# --- RUTA DE BINARIOS PARA RESPALDOS (Crítico para v1.4) ---
# Esta ruta permite que Spatie Backup encuentre el comando pg_dump.exe
DUMP_BINARY_PATH="C:/Program Files/PostgreSQL/17/bin"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="soporte@sgcj.gob.ve"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=12345
REVERB_APP_KEY=sgcj_key
REVERB_APP_SECRET=sgcj_secret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# En una red local, reemplazar por la IP del servidor (ej: 192.168.1.10).
# Requiere recompilar con: npm run build
VITE_REVERB_HOST="127.0.0.1"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Límites de carga en kilobytes (1 MB = 1024 KB).
# Deben quedar por debajo de upload_max_filesize y post_max_size de php.ini.
SGCJ_MAX_PDF_KB=512000
SGCJ_MAX_IMAGEN_KB=10240
